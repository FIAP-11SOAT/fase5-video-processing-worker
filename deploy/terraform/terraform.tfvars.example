# Exemplo de arquivo terraform.tfvars
# Copie este arquivo para terraform.tfvars e ajuste os valores

# Nome do cluster EKS
cluster_name = "seu-cluster-eks"

# Nome do bucket S3
s3_bucket_name = "fase5-video-processing-bucket"

# Nome da fila SQS (opcional, usa o default se nao especificado)
# sqs_queue_name = "fase5-video-processing-queue"

# Nome da tabela DynamoDB (opcional, usa o default se nao especificado)
# dynamodb_table_name = "fase5-video-status"

# ARN do topico SNS para notificacoes (opcional)
# sns_topic_arn = "arn:aws:sns:us-east-1:814147156565:fase5-notifications"

# Regiao AWS (opcional, usa us-east-1 se nao especificado)
# aws_region = "us-east-1"

# Namespace Kubernetes (opcional, usa o default se nao especificado)
# namespace = "fase5-video-processing-worker"

# Nome do Service Account (opcional, usa o default se nao especificado)
# service_account_name = "video-processing-worker-sa"
